def sum(list, res)
  if(list.length()==0)
    return res  # التعديل هنا: إعادة المتغير res بدلاً من 0
  else
    # التعديل هنا: استخدام [1..-1] لاقتصاص الباقي من المصفوفة
    return sum(list[1,list.length()+1], res + list[0])
  end
end

list = [324, 545, 6566, 456]

result = sum(list, 0)

puts(result) # الناتج الصحيح: 7891
